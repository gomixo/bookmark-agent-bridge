{
  "manifest_version": 3,
  "name": "Bookmark Agent Bridge",
  "version": "0.1.0",
  "description": "Connects a local Agent to this Chrome profile's native bookmarks.",
  "permissions": ["bookmarks", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* ws://localhost:*"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmark Agent Bridge"
  },
  "options_page": "options.html"
}
